<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional: IIS as HTTPS front door (needs the URL Rewrite + Application Request Routing modules,
  with ARR proxy enabled). Put this file in the IIS site's physical folder.
  Everything is proxied to the app on 127.0.0.1:8000, which also serves the web UI.
  Then set TRUST_PROXY=true in .env.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ProxyAll" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
