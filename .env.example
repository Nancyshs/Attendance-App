# Copy to .env and edit. Never commit the real .env.
ENVIRONMENT=production

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# MySQL 8 (create the database + user first, see DEPLOY.md)
DATABASE_URL=mysql+pymysql://attendance:CHANGE_ME@127.0.0.1:3306/attendance?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

TIMEZONE=Africa/Cairo

# The address trainees' phones will open. It is encoded inside every badge QR code,
# so set the FINAL address before printing badges.
PUBLIC_URL=https://attendance.example.com

# true only when the app sits behind IIS / a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Where photos are stored (default: backend\data). Back this folder up too.
# MEDIA_DIR=D:\attendance-data
